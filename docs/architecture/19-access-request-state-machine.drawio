<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Access Request State Machine"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Request submitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0" vertex="1" parent="1"><mxGeometry x="60" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="p" value="Pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825" vertex="1" parent="1"><mxGeometry x="300" y="180" width="160" height="60" as="geometry"/></mxCell><mxCell id="a" value="Approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32" vertex="1" parent="1"><mxGeometry x="550" y="100" width="160" height="60" as="geometry"/></mxCell><mxCell id="r" value="Rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828" vertex="1" parent="1"><mxGeometry x="550" y="260" width="160" height="60" as="geometry"/></mxCell><mxCell id="x" value="Expired / no longer actionable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#616161" vertex="1" parent="1"><mxGeometry x="800" y="180" width="210" height="60" as="geometry"/></mxCell><mxCell id="d" value="Decision-maker\nSuper Admin OR users.access_requests.decide within target scope" style="shape=note;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="280" y="330" width="320" height="100" as="geometry"/></mxCell><mxCell id="e1" value="create" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="s" target="p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Take decision → approve" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="p" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Take decision → reject" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="p" target="r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="request no longer actionable" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="p" target="x"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="decision creates / updates access" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="a" target="x"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="decision recorded" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="r" target="x"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>