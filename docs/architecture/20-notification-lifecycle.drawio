<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Notification Lifecycle"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e" value="Event / manual send" style="rounded=1;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="50" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="r" value="NotificationRuleService\n(rule matching / decision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32" vertex="1" parent="1"><mxGeometry x="290" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="n" value="NotificationService\n(recipient resolution + send)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd" vertex="1" parent="1"><mxGeometry x="590" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="q" value="Queued notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825" vertex="1" parent="1"><mxGeometry x="890" y="180" width="190" height="60" as="geometry"/></mxCell><mxCell id="c" value="Client portal notification\nvisible to recipient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2" vertex="1" parent="1"><mxGeometry x="1150" y="180" width="220" height="70" as="geometry"/></mxCell><mxCell id="a" value="AuditLogger\nqueued / failed" style="shape=note;whiteSpace=wrap;html=1" vertex="1" parent="1"><mxGeometry x="700" y="330" width="220" height="80" as="geometry"/></mxCell><mxCell id="f" value="Queue failure / exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828" vertex="1" parent="1"><mxGeometry x="930" y="330" width="210" height="60" as="geometry"/></mxCell><mxCell id="e1" value="trigger" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="e" target="r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="matched rule / direct send" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="r" target="n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="recipients resolved" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="n" target="q"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="deliver / persist" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="q" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="success audit" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="n" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="failure audit" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1" edge="1" parent="1" source="n" target="f"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>